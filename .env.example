# Copie para .env (nao commite o .env com IDs reais se o repo for publico... na verdade
# publisher ID e publico por natureza — o ads.txt expoe ele de qualquer forma).
# Sem VITE_ADSENSE_CLIENT, nenhum script de anuncio e carregado (site funciona normal).

# ID de publisher do AdSense (ca-pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_CLIENT=

# IDs dos blocos criados no painel do AdSense (um por posicao)
VITE_AD_SLOT_HERO=
VITE_AD_SLOT_MID=
VITE_AD_SLOT_BOTTOM=
